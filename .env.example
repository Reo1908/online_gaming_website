# Vorlage fuer die .env im Projektwurzelverzeichnis.
# Docker Compose liest diese Datei automatisch fuer compose.prod.yml.
#
#   cp .env.example .env
#
# Die echte .env ist per .gitignore ausgeschlossen und gehoert nicht ins Repo.
# Nicht zu verwechseln mit apps/api/.env -- die gilt nur fuer `npm run dev`.

POSTGRES_USER=friendgames
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=friendgames

# Mindestens 32 Zeichen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Die Domain, unter der die Seite erreichbar ist -- ohne Schema. Caddy holt
# dafuer das Zertifikat. Sie muss per DNS auf diesen Server zeigen, sonst
# scheitert die Ausstellung.
PUBLIC_DOMAIN=spiele.deine-domain.de

# Dieselbe Adresse noch einmal, diesmal mit Schema und ohne Schraegstrich am
# Ende. Davon haengt ab, ob das Session-Cookie das Secure-Flag bekommt --
# steht hier https, die Seite laeuft aber ueber http, verwirft der Browser
# das Cookie kommentarlos und niemand bleibt angemeldet.
APP_ORIGIN=https://spiele.deine-domain.de

# Nach aussen geht Caddy auf 80 und 443. Diese Zeile oeffnet nur einen
# zusaetzlichen Zugang zum Nachsehen und bleibt per Vorgabe auf dem Server
# selbst -- ohne "127.0.0.1:" davor haengt die Anwendung unverschluesselt
# im Netz.
WEB_PORT=127.0.0.1:8080

# Welchen vorgelagerten Adressen geglaubt wird, wenn sie in X-Forwarded-For
# eine Besucher-IP behaupten. "uniquelocal" deckt die privaten Netze ab und
# passt sowohl fuer den nginx aus dem web-Dienst als auch fuer einen TLS-Proxy
# auf demselben Rechner. Davon haengt ab, welche IP das Rate-Limit sieht.
# Moeglich sind auch "loopback", einzelne IPs und CIDR-Bereiche (Komma-Liste).
TRUST_PROXY=uniquelocal

# --- Nur fuer den einmaligen Seed-Lauf: erster Administrator ---
# Werte eintragen, einmal seeden (siehe README, Abschnitt "Auf einem Server"),
# danach wieder loeschen und `docker compose ... up -d` wiederholen. Dann
# stehen sie auch nicht mehr in der Umgebung des laufenden Containers.
# Passwort mindestens 12 Zeichen; nach dem ersten Login unter /profile aendern.
#ADMIN_BOOTSTRAP_USERNAME=sysadmin
#ADMIN_BOOTSTRAP_PASSWORD=

# --- Nur fuer compose.deploy.yml (fertige Images vom Server ziehen) ---
# Dein GitHub-Repository in Kleinbuchstaben, z. B. nickhamn01/online_gaming_website
GITHUB_REPOSITORY=dein-benutzer/dein-repo
# Welche Image-Version laufen soll: latest, 1.2.0 oder ein Commit-Kuerzel
IMAGE_TAG=latest

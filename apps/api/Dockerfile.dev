# syntax=docker/dockerfile:1
#
# Entwicklungs-Image. Bewusst NICHT mehrstufig: hier werden Compiler und
# Dev-Abhaengigkeiten gebraucht, der Quelltext kommt zur Laufzeit per Mount
# aus compose.dev.yml. Fuer den echten Betrieb siehe Dockerfile.

FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssl ca-certificates \
      python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

# Alle Abhaengigkeiten, auch die fuer die Entwicklung (tsx, typescript).
COPY package.json package-lock.json ./
RUN npm ci

# Der Prisma Client wird schon beim Bauen erzeugt: er landet in node_modules
# und damit im Image. Der spaetere Mount deckt nur src/ und prisma/ ab,
# node_modules bleibt unangetastet.
COPY prisma ./prisma
RUN npx prisma generate

COPY tsconfig.json ./

# Dateiaenderungen von Windows nach Linux loesen ueber einen Bind-Mount keine
# inotify-Ereignisse aus. Ohne Polling wuerde tsx die Aenderung nie bemerken.
ENV CHOKIDAR_USEPOLLING=true
ENV CHOKIDAR_INTERVAL=1000

EXPOSE 3000

CMD ["npm", "run", "dev"]

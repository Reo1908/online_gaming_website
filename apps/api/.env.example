# Verbindungsdaten muessen zu compose.yml passen
DATABASE_URL="postgresql://friendgames:devpassword@localhost:5432/friendgames"

# Mindestens 32 Zeichen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Origin des Frontends, wird fuer CORS benoetigt
APP_ORIGIN="http://localhost:4200"

PORT=3000
NODE_ENV="development"

# Vorgelagerte Adressen, denen ihr X-Forwarded-For geglaubt wird. In der
# Entwicklung steht kein Proxy davor, der einen setzt -- der Standard
# "uniquelocal" stoert hier also nicht.
#TRUST_PROXY=uniquelocal

# Erster Admin-Zugang, angelegt durch `npm run db:seed`.
# Passwort mindestens 12 Zeichen; nach dem ersten Login aendern.
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSWORD=""

# Werden von Docker Compose fuer den Postgres-Container gelesen
POSTGRES_USER="friendgames"
POSTGRES_PASSWORD="devpassword"
POSTGRES_DB="friendgames"
